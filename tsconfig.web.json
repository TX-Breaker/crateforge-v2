{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@core/*": ["src/core/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/api.d.ts",
    "src/core/camelot.ts",
    "src/core/harmony.ts",
    "src/core/djVersions.ts",
    "src/core/djDetection.ts",
    "src/core/djRegistry.ts",
    "tests/i18nParity.test.ts",
    "tests/djRegistry.wizard.test.ts"
  ]
}
